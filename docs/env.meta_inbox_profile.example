# Copy relevant keys into your real .env. Never commit secrets.

# Graph API version for Meta Inbox profile lookups (and other Meta Inbox Graph calls).
# META_INBOX_GRAPH_API_VERSION takes precedence; GRAPH_API_VERSION is a documented alias.
GRAPH_API_VERSION=v25.0
META_INBOX_GRAPH_API_VERSION=v25.0

# Contact avatar mirroring (Meta CDN URLs expire — we download into MEDIA_ROOT / default_storage)
SOCIAL_AVATAR_MAX_BYTES=5242880
SOCIAL_AVATAR_DOWNLOAD_TIMEOUT_SECONDS=10

# Set true only for local debugging / tests — runs profile enrichment inline in the webhook.
# META_INBOX_PROFILE_ENRICH_SYNC=false
