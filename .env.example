# Object storage — Cloudflare R2 (docs/STORAGE.md)
# Leave ACCOUNT_ID / ENDPOINT empty → local disk under MEDIA_ROOT (dev/CI).
# Setting R2_ACCOUNT_ID or R2_ENDPOINT_URL switches media/public/backups to R2
# when OBJECT_STORAGE_BACKEND is unset.
OBJECT_STORAGE_BACKEND=local
RECORDING_STORAGE_BACKEND=local

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_SECRET_ACCESS_KEY_FILE=/path/to/secret   # alt to inline secret
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=http://127.0.0.1:9000       # local SeaweedFS stand-in
R2_REGION=auto
R2_MEDIA_BUCKET=loop-crm-media
R2_RECORDINGS_BUCKET=loop-pbx-recordings
# R2_BACKUP_BUCKET=                 # defaults to media bucket
# R2_PUBLIC_BUCKET=                 # requires R2_PUBLIC_DOMAIN
# R2_PUBLIC_DOMAIN=media.example.com
# R2_MEDIA_URL_TTL=21600
# R2_URL_WINDOW=3600

# Deprecated fallbacks (prefer R2_* above): RECORDING_S3_*, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# Production SIP edge (CRM-pbx/docs/production-rollout.md). Static mode is dev only.
# TELEPHONY_WEBRTC_AUTH=edge
# TELEPHONY_SIP_WS_URI=wss://sip.example.com/ws
# TELEPHONY_SIP_DOMAIN=sip.example.com
# TELEPHONY_SIP_EDGE_PROXY=127.0.0.1:5065
# TELEPHONY_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# PBX_SIP_EPHEMERAL_SECRET_FILE=/run/credentials/crm-api.service/sip-ephemeral
# PBX_TURN_SECRET_FILE=/run/credentials/crm-api.service/turn
